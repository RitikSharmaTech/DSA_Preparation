
class Pair {
    int min;
    int max;
    int sum;
    boolean isBST;

    Pair(int min, int max, int sum, boolean isBST) {
        this.min = min;
        this.max = max;
        this.sum = sum;
        this.isBST = isBST;
    }
}

class Solution {

    int ans = 0;

    public int maxSumBST(TreeNode root) {
        solve(root);
        return ans;
    }

    Pair solve(TreeNode root) {

        // Empty tree is a BST
        if (root == null) {
            return new Pair(
                Integer.MAX_VALUE,
                Integer.MIN_VALUE,
                0,
                true
            );
        }

        Pair left = solve(root.left);
        Pair right = solve(root.right);

        // Check whether current subtree is BST
        if (left.isBST &&
            right.isBST &&
            left.max < root.val &&
            root.val < right.min) {

            int sum = left.sum + root.val + right.sum;

            ans = Math.max(ans, sum);

            int min = Math.min(root.val, left.min);
            int max = Math.max(root.val, right.max);

            return new Pair(min, max, sum, true);
        }

        // Current subtree is NOT a BST
        return new Pair(
            Integer.MIN_VALUE,
            Integer.MAX_VALUE,
            0,
            false
        );
    }
}
