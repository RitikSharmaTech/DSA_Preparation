class Solution {
   public int minCost(int[] arr) {
           PriorityQueue<Integer> pq = new PriorityQueue<>();
     
           for(int ele : arr) {
               pq.add(ele);
           }  
                    int total = 0;
               while(pq.size()>1) {
                   int top = pq.remove();
                   int secondTop = pq.remove();

                  int  sum = top+secondTop;
                   pq.add(sum);
                   total = total + sum;
           }
           return total;
       }
}
